# ---------------------------------------------------------------------------
# Wardrobe Business — backend configuration. Copy to `.env` and fill in.
# Never commit `.env` (it is git-ignored).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose up -d starts one on port 5432)
DATABASE_URL=postgresql://wardrobe:wardrobe@localhost:5432/wardrobe?schema=public

# Origins of the frontend allowed to call the API with cookies (comma separated)
CLIENT_ORIGIN=http://localhost:3000

# JWT secret for access tokens: at least 32 random characters in production
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# A refresh token presented again within N seconds after its rotation is treated as a
# parallel refresh of another tab (rejected without logging the user out everywhere)
REFRESH_REUSE_GRACE_SECONDS=20
REFRESH_COOKIE_NAME=wb_refresh
# true when the site is served over HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Max sign-in attempts per minute from one client
LOGIN_RATE_LIMIT=5

# Business day boundaries for analytics (Asia/Tashkent = UTC+5 → 300)
BUSINESS_UTC_OFFSET_MINUTES=300

# Photo uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# --- Seed: the two accounts (used only by `npm run seed`, only when an account does not exist yet).
# Prefer passing them as environment variables for the single seed run instead of storing
# real passwords in this file; the database keeps only bcrypt hashes.
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER1_FIRST_NAME=
SEED_USER1_LAST_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
SEED_USER2_FIRST_NAME=
SEED_USER2_LAST_NAME=

# --- Online store (style-hub-back) synchronisation, server side only
# GraphQL endpoint of the store, e.g. https://api.example.uz/graphql
STORE_GRAPHQL_URL=
# Store account with role ADMIN (e-mail or phone) and its password
STORE_LOGIN=
STORE_PASSWORD=
# Currency of prices in the store
STORE_CURRENCY=UZS
# Automatic sync interval in minutes (0 = only manual sync from the interface)
STORE_SYNC_INTERVAL_MINUTES=0
STORE_PAGE_SIZE=100
STORE_TIMEOUT_MS=20000
